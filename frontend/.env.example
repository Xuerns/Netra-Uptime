# Frontend environment variables are now configured in the ROOT .env file.
# Set PUBLIC_API_URL there — no rebuild needed.
#
# Example (in root .env):
#   PUBLIC_API_URL=https://myapp.com/api/v1
#
# This file is only needed for local development with `pnpm dev`.
# When running via Docker, the root .env is used automatically.

PUBLIC_API_URL=http://localhost:8080/api/v1
PUBLIC_APP_MODE=selfhosted
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
PUBLIC_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/google
