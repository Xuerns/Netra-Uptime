# -----------------------------------------------------------------------------
# Netra Uptime - System Environment Configuration Example
# -----------------------------------------------------------------------------

# Application Environment & Mode
APP_ENV=development         # Options: development, production
APP_MODE=selfhosted         # Options: selfhosted, production  (if you want to use Oauth choose production)
PUBLIC_APP_MODE=selfhosted  # Options: selfhosted,  production (if you want to use Oauth choose production)
PORT=8080                   # Primary HTTP Port for Netra Uptime Single Container

# Security & JWT Credentials
JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_characters   # Required in production: min 32 chars (e.g. openssl rand -hex 32)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# PostgreSQL Database Configuration
POSTGRES_USER=netra
POSTGRES_PASSWORD=netra_secret_change_me
POSTGRES_DB=netra_uptime
POSTGRES_PORT=5432
DB_HOST=postgres            # Use 'postgres' for Docker Compose, or 'localhost' / IP
DB_PORT=5432
DB_USER=netra
DB_PASSWORD=netra_secret_change_me
DB_NAME=netra_uptime
DB_SSLMODE=disable

# Redis Cache & Rate Limiter Configuration
REDIS_HOST=redis            # Use 'redis' for Docker Compose, or 'localhost' / IP
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_me

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:8080

# Client Configuration (served dynamically, no rebuild needed)
PUBLIC_API_URL=http://localhost:8080/api/v1   # Change to your domain in production (e.g. https://myapp.com/api/v1)

# -----------------------------------------------------------------------------
# Self-Hosted Operational Rules & Quota Limits
# -----------------------------------------------------------------------------
RECENT_CHECKS_LIMIT=60       # Number of recent check status bars in UI dashboard (default: 60)
SELFHOSTED_MAX_MONITORS=0    # Max monitors per organization (0 = unlimited)
SELFHOSTED_MAX_ORGS=0        # Max organizations per user account (0 = unlimited)
SELFHOSTED_MAX_MEMBERS=0     # Max members per organization (0 = unlimited)
SELFHOSTED_MAX_PIC=10        # Max Person-In-Charge assigned per monitor (default: 10)
SELFHOSTED_MIN_INTERVAL=10   # Minimum allowed check frequency in seconds (default: 10s)
SELFHOSTED_MAX_TIMEOUT=60    # Maximum allowed request timeout in seconds (default: 60s)

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com                         # SMTP server host (e.g. smtp.gmail.com, mail.example.com)
SMTP_PORT=587                                    # SMTP port (typically 587 for TLS/STARTTLS, 465 for SSL)
SMTP_EMAIL=your_email@gmail.com                  # Example: your SMTP sender/login account
SMTP_PASSWORD=your_smtp_app_password             # Example: your SMTP App Password (do NOT use plain account password)

# Google OAuth 2.0 (Optional)
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
PUBLIC_GOOGLE_REDIRECT_URL=http://localhost:8080/oauth/callback