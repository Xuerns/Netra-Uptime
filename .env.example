# -----------------------------------------------------------------------------
# Netra Uptime - System Environment Configuration Example
# -----------------------------------------------------------------------------

# Application Environment
APP_ENV=development         # Options: development, production
PORT=27346                   # Primary HTTP Port for Netra Uptime Single Container

# Security & JWT Credentials
JWT_SECRET=your_random_secret_of_at_least_32_characters   # Required in production: min 32 chars (e.g. openssl rand -hex 32). Insecure placeholders will be rejected in production.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# PostgreSQL Database Configuration
POSTGRES_USER=netra
POSTGRES_PASSWORD=netra_secret_change_me
POSTGRES_DB=netra_uptime
POSTGRES_PORT=5432
DB_HOST=postgres            # Use 'postgres' for Docker Compose, or 'localhost' / IP
DB_PORT=5432
DB_USER=netra
DB_PASSWORD=netra_secret_change_me
DB_NAME=netra_uptime
DB_SSLMODE=disable

# Redis Cache & Rate Limiter Configuration
REDIS_HOST=redis            # Use 'redis' for Docker Compose, or 'localhost' / IP
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_me
AUTH_RATE_LIMIT=60          # Max login & register attempts per minute per IP (default: 60)

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:27346

# Client Configuration (served dynamically, no rebuild needed)
PUBLIC_API_URL=http://localhost:27346/api/v1   # Change to your domain in production (e.g. https://myapp.com/api/v1)

# -----------------------------------------------------------------------------
# Safety Guardrails (Self-Hosted / Open-Source System Limits)
# -----------------------------------------------------------------------------
ALLOW_REGISTRATION=true                # Allow public user registration (true/false, default: true)
MAX_MONITORS_PER_ORG=200               # Max monitors allowed per organization (default: 200)
MAX_STATUS_PAGES_PER_ORG=10            # Max status pages allowed per organization (default: 10)
MAX_ORGS_PER_USER=10                   # Max organizations created per user account (default: 10)
MAX_MEMBERS_PER_ORG=100                # Max team members per organization (default: 100)
MAX_ASSIGNEES_PER_MONITOR=50           # Max Person-In-Charge / assignees per monitor (default: 50)
RECENT_CHECKS_LIMIT=60                 # Number of recent check status bars in UI dashboard (default: 60)
SELFHOSTED_MIN_INTERVAL=30             # Minimum allowed check frequency in seconds (default: 30s)
SELFHOSTED_MAX_TIMEOUT=30              # Maximum allowed request timeout in seconds (default: 30s)
MIN_MONITOR_INTERVAL_SECONDS=30        # Minimum allowed check frequency in seconds (engine hard floor: 30s)
DEFAULT_MONITOR_INTERVAL_SECONDS=60    # Default interval in seconds when creating a new monitor

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com                         # SMTP server host (e.g. smtp.gmail.com, mail.example.com)
SMTP_PORT=587                                    # SMTP port (typically 587 for TLS/STARTTLS, 465 for SSL)
SMTP_EMAIL=your_email@gmail.com                  # Example: your SMTP sender/login account
SMTP_PASSWORD=your_smtp_app_password             # Example: your SMTP App Password (do NOT use plain account password)