# -----------------------------------------------------------------------------
# PulseWatch - System Environment Configuration Example
# -----------------------------------------------------------------------------

# Application Environment & Mode
APP_ENV=production          # Options: development, production
PORT=8080                   # Primary HTTP Port for PulseWatch Single Container

# Security & JWT Credentials
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# PostgreSQL Database Configuration
POSTGRES_USER=pulsewatch_user
POSTGRES_PASSWORD=pulsewatch_secret_change_me
POSTGRES_DB=pulsewatch_db
POSTGRES_PORT=5432
DB_HOST=postgres            # Use 'postgres' for Docker Compose, or 'localhost' / IP
DB_PORT=5432
DB_USER=pulsewatch_user
DB_PASSWORD=pulsewatch_secret_change_me
DB_NAME=pulsewatch_db
DB_SSLMODE=disable

# Redis Cache & Rate Limiter Configuration
REDIS_HOST=redis            # Use 'redis' for Docker Compose, or 'localhost' / IP
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_me

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:8080

# Frontend Configuration (served dynamically, no rebuild needed)
PUBLIC_API_URL=http://localhost:8080/api/v1   # Change to your domain in production (e.g. https://myapp.com/api/v1)

# -----------------------------------------------------------------------------
# Self-Hosted Operational Rules & Quota Limits
# -----------------------------------------------------------------------------
RECENT_CHECKS_LIMIT=60       # Number of recent check status bars in UI dashboard (default: 60)
SELFHOSTED_MAX_MONITORS=0    # Max monitors per organization (0 = unlimited)
SELFHOSTED_MAX_ORGS=0        # Max organizations per user account (0 = unlimited)
SELFHOSTED_MAX_MEMBERS=0     # Max members per organization (0 = unlimited)
SELFHOSTED_MAX_PIC=10        # Max Person-In-Charge assigned per monitor (default: 10)
SELFHOSTED_MIN_INTERVAL=10   # Minimum allowed check frequency in seconds (default: 10s)
SELFHOSTED_MAX_TIMEOUT=60    # Maximum allowed request timeout in seconds (default: 60s)

# -----------------------------------------------------------------------------
# Optional Integrations (Email / OAuth)
# -----------------------------------------------------------------------------
# Email (Resend API)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=PulseWatch <onboarding@resend.dev>

# Email (SMTP Provider fallback)
SMTP_PASSWORD=your smtp password
SMTP_EMAIL=pulsewatch.noreply@gmail.com
SMTP_PORT=587

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/google
