# -----------------------------------------------------------------------------
# Root .gitignore for Netra Uptime Monorepo
# -----------------------------------------------------------------------------

# Sensitive Environment Files & Auto-Generated Secrets (NEVER COMMIT)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
.netra_secret
**/.netra_secret

# SQLite Databases & WAL/SHM Runtime Files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Dependencies
node_modules/
**/node_modules/

# Build Outputs & Binary Files (Only keep the placeholder index.html for Go embed)
build/
**/build/
!server/internal/static/build/
server/internal/static/build/*
!server/internal/static/build/index.html
dist/
**/dist/
.svelte-kit/
**/.svelte-kit/
.output/
.vercel/
.wrangler/
tmp/
**/tmp/
/bin/
*.exe
*.test
*.out

# Logs
*.log
logs/
**/logs/
!client/src/routes/dashboard/logs/
!client/src/routes/dashboard/org/*/logs/

# OS & System Junk
.DS_Store
Thumbs.db
*~

# IDE & Editor Settings
.vscode/
.idea/
*.swp
skills-lock.json

# Mark & Security Reports
security_audit_report.md

# Documentation filtering (only allow docs/DESIGN.md)
docs/*
!docs/DESIGN.md
